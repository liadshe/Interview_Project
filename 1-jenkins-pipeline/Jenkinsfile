@Library('my-shared-library') _

pipeline {
    agent any
    
    triggers {
        // trigger the pipeline on GitHub push events      
        githubPush()
    }
    
    environment {
        APP_NAME = "interview-application"
        ARTIFACTORY_URL = "http://192.168.7.29:8081/artifactory/generic-local"
    }
    
    stages {
        stage('Prepare Environment') {
            steps {
                script {
                    // uses shared library 
                    prepareEnv()
                }
            }
        }
        
        stage('Build Artifact') {
            steps {
                sh '''
                    rm -rf dist && mkdir dist
                    cp -r 2-ansible-docker/files 2-ansible-docker/templates dist/
                    printf '{"commit":"%s","committer":"%s","build":"%s"}\n' \
                    "$SCM_COMMIT_ID" "$SCM_COMMITTER" "$BUILD_NUMBER" > dist/build-info.json
                '''
            }
        }
        
        stage('Pack Artifact') {
            steps {
                script {
                    env.ARTIFACT_NAME = "${env.APP_NAME}-${env.BUILD_NUMBER}-${env.SCM_COMMIT_ID}.tar.gz"
                }
                sh 'tar -czf "$ARTIFACT_NAME" -C dist .'
                archiveArtifacts artifacts: '*.tar.gz', fingerprint: true
            }
        }
        
        stage('Upload to Repo') {
            steps {
                 withCredentials([usernamePassword(
                        credentialsId: 'artifactory-creds',
                        usernameVariable: 'REPO_USER',
                        passwordVariable: 'REPO_PASS')]) {
                    sh '''
                        printf 'user = "%s:%s"\n' "$REPO_USER" "$REPO_PASS" | \
                          curl --fail --silent --show-error -K - \
                               -T "$ARTIFACT_NAME" \
                               "$ARTIFACTORY_URL/$ARTIFACT_NAME"
                    '''
                }
            }
        }
    }
    
    post {
        always {
            echo "Cleaning up workspace..."
            cleanWs() 
        }
        failure { echo "FAILED. Last committer: ${env.SCM_COMMITTER}" }
        success {
            echo "Pipeline completed successfully!"
        }
    }
}

@Library('my-shared-library') _

pipeline {
    agent any
    
    triggers {
        // trigger the pipeline on GitHub push events      
        githubPush()
    }
    
    environment {
        APP_NAME = "interview-application"
        ARTIFACT_NAME = "${APP_NAME}-${env.BUILD_NUMBER}.tar.gz"
        REPO_URL = "http://192.168.7.29:8081/repository/my-repo"
    }
    
    stages {
        stage('Prepare Environment') {
            steps {
                script {
                    // uses shared library 
                    prepareEnv()
                }
            }
        }
        
        stage('Build Artifact') {
            steps {
                sh '''
                    rm -rf dist && mkdir dist
                    cp -r 2-ansible-docker/files 2-ansible-docker/templates dist/
                    printf '{"commit":"%s","committer":"%s","branch":"%s","build":"%s"}\n' \
                    "$SCM_COMMIT_ID" "$SCM_COMMITTER" "$SCM_BRANCH" "$BUILD_NUMBER" > dist/build-info.json
                '''
            }
        }
        
        stage('Pack Artifact') {
            steps {
                script {
                    env.ARTIFACT_NAME = "${env.APP_NAME}-${env.BUILD_NUMBER}-${env.SCM_COMMIT_ID}.tar.gz"
                }
                sh 'tar -czf "$ARTIFACT_NAME" -C dist .'
                archiveArtifacts artifacts: '*.tar.gz', fingerprint: true
            }
        }
        
        stage('Upload to Repo') {
            steps {
                echo "Uploading ${ARTIFACT_NAME} to artifact repository..."
                withCredentials([usernamePassword(credentialsId: 'artifactory-creds', passwordVariable: 'REPO_PASS', usernameVariable: 'REPO_USER')]) {
                    sh """
                        curl -u ${REPO_USER}:${REPO_PASS} \
                             -X PUT \
                             -T ${ARTIFACT_NAME} \
                             ${REPO_URL}/${ARTIFACT_NAME}
                    """
                }
            }
        }
    }
    
    post {
        always {
            echo "Cleaning up workspace..."
            cleanWs() 
        }
        success {
            echo "Pipeline completed successfully!"
        }
    }
}

#!/usr/bin/env bash

# set global args
VERBOSE=0; RECURSIVE=0; OK=0; FAIL=0

usage() {
  echo "Usage: extract [-h] [-r] [-v] file [file...]"
  echo "  -h  show this help"
  echo "  -r  recurse into directories"
  echo "  -v  print each unpacked file, warn about each file not unpacked"
}

# Decompress a single-stream file in place: write to a temp file, then replace.
stream() {
  "$1" < "$2" > "$2.tmp" && mv -f "$2.tmp" "$2" || { rm -f "$2.tmp"; return 1; }
}

# To add a new format, add ONE line here
unpack() {
  case $(file -b -- "$1") in
    *"gzip compressed"*)  stream gunzip "$1" && { unpack "$1"; true; } ;; # recursively unpack gzip files
    *"bzip2 compressed"*) stream bunzip2 "$1" ;;
    *"compress'd data"*)  stream uncompress "$1" ;;
    *"Zip archive"*)      unzip -qo "$1" -d "$(dirname "$1")" ;;
    *"tar archive"*)      tar -xf "$1" -C "$(dirname "$1")" ;;  
    *)                    return 1 ;;   # not compressed: do nothing
  esac
}

handle() {
  if unpack "$1"; then
    OK=$((OK + 1));     (( VERBOSE )) && echo "Unpacked: $1"
  else
    FAIL=$((FAIL + 1)); (( VERBOSE )) && echo "Warning: not unpacked: $1"
  fi
}

while getopts "hrv" opt; do
  case $opt in
    h) usage; exit 0 ;;
    r) RECURSIVE=1 ;;
    v) VERBOSE=1 ;;
    *) usage; exit 255 ;;
  esac
done
shift $((OPTIND - 1))

# if no files are specified, print usage and exit with error code 255
[ $# -eq 0 ] && { usage; exit 255; }

# Collect all files first, so files created by unzip are not processed again.
files=()
for arg in "$@"; do
  if [ -d "$arg" ]; then
    depth=(-maxdepth 1); (( RECURSIVE )) && depth=()
    while IFS= read -r -d '' f; do files+=("$f"); done \
      < <(find "$arg" "${depth[@]}" -type f -print0)
  else
    files+=("$arg")
  fi
done

# process each file in the list
for f in "${files[@]}"; do handle "$f"; done

echo "Number of archives decompressed: $OK"
exit $(( FAIL > 255 ? 255 : FAIL ))
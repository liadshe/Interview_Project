#!/bin/bash

# global vars
VERBOSE=0
RECURSIVE=0
SUCCESS_COUNT=0
FAIL_COUNT=0

# help 
show_help() {
    echo "Usage: extract [-h] [-r] [-v] file [file...]"
    echo ""
    echo "Unpack multiple compressed files regardless of their extensions."
    echo "The script identifies the compression algorithm using the 'file' command."
    echo ""
    echo "Options:"
    echo "  -h    Show this help message"
    echo "  -r    Recursive mode: traverse contents of folders recursively"
    echo "  -v    Verbose mode: echo each decompressed file & warn for failures"
    exit 0
}

# flags defenition using getopts
while getopts "hrv" opt; do
    case ${opt} in
        h )
            show_help
            ;;
        r )
            RECURSIVE=1
            ;;
        v )
            VERBOSE=1
            ;;
        \? )
            show_help
            ;;
    esac
done


shift $((OPTIND -1))

# check if at least one file is provided
if [ $# -eq 0 ]; then
    echo "Error: No files provided."
    show_help
fi


process_target() {
    local target="$1"
    
    # check if path is exist and is a directory 
    if [ -d "$target" ]; then
        # checks if recursive flag is on
        if [ "$RECURSIVE" -eq 1 ]; then
            # scan the children objects in the directory
            for child in "$target"/*; do
                # if the directory is empty, continue 
                [ -e "$child" ] || continue
                # recursivly run on child
                process_target "$child"
            done
        else
            # if verbose + is a directory but no recursive flag, print warning
            if [ "$VERBOSE" -eq 1 ]; then
                echo "Warning: '$target' is a directory. Use -r to traverse."
            fi
            # increase fail count because the directory was not processed
            ((FAIL_COUNT++))
        fi
        return
    fi

    # check if path not exist or not a file
    if [ ! -f "$target" ]; then
        if [ "$VERBOSE" -eq 1 ]; then
            echo "Warning: '$target' is not a valid file."
        fi
        ((FAIL_COUNT++))
        return
    fi

    # get file type
    local file_type
    file_type=$(file -b "$target")

    # initialize decompressed flag
    local decompressed=0

    # decompression method based on file type
    case "$file_type" in
        *gzip\ compressed\ data*)
            gunzip -f "$target" && decompressed=1
            ;;
        *bzip2\ compressed\ data*)
            bunzip2 -f "$target" && decompressed=1
            ;;
        *Zip\ archive\ data*)
            # 
            unzip -q -o "$target" -d "$(dirname "$target")" && decompressed=1
            ;;
        *compress\'d\ data* | *compressed\ data\ 16\ bits*)
            uncompress -f "$target" && decompressed=1
            ;;
        *)
            # unkown format, move on 
            decompressed=0
            ;;
    esac

    # update success counter and print if needed
    if [ "$decompressed" -eq 1 ]; then
        ((SUCCESS_COUNT++))
        if [ "$VERBOSE" -eq 1 ]; then
            echo "Decompressed: $target"
        fi
    else
        ((FAIL_COUNT++))
        if [ "$VERBOSE" -eq 1 ]; then
            echo "Warning: Could not decompress (or not compressed) -> $target"
        fi
    fi
}

# main loop to process each argument
for arg in "$@"; do
    process_target "$arg"
done

# print all succssful decompressions
echo "Number of archives decompressed: $SUCCESS_COUNT"

# return as exit code failed decompressions
exit $FAIL_COUNT